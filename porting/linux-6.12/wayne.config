# Initial upstream bring-up; this is not an Android 14 vendor-compatible configuration.
CONFIG_LOCALVERSION="-wayne-bringup"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_QCOM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_PINCTRL_SDM660=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_SDM_GCC_660=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SDM660=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# No unvalidated remote firmware startup in the first bring-up image.
# CONFIG_QCOM_Q6V5_ADSP is not set
# CONFIG_QCOM_Q6V5_MSS is not set
# CONFIG_QCOM_Q6V5_PAS is not set
